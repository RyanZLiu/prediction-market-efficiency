PME_DB_PATH=data/pme.duckdb
PME_HTTP_TIMEOUT=20
PME_USER_AGENT=prediction-market-efficiency/0.1

# Optional: only needed for authenticated Kalshi WebSocket access.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2

POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Research-cost assumptions. Replace with values appropriate to your study.
KALSHI_FEE_BPS=0
POLYMARKET_FEE_BPS=0
SLIPPAGE_BPS=5

# Optional sportsbook data via The Odds API
ODDS_API_KEY=


# Polymarket US
# Public REST market data needs no credentials. These two values enable the
# authenticated market WebSocket for sub-second live quotes.
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=
POLYMARKET_US_TAKER_FEE_COEFFICIENT=0.06
